{
  "name": "functions",
  "description": "Cloud Functions for TransFarm (Farmarga) backend",
  "private": true,
  "engines": {
    "node": "24"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "lint": "eslint .",
    "seed:markets": "tsc && node lib/scripts/seedMarketCommodities.js",
    "seed:master": "tsc && node lib/scripts/seedMasterData.js",
    "migrate:members": "tsc && node lib/scripts/migrateMembersToSubcollection.js",
    "backfill:subscriptions": "tsc && node lib/scripts/backfillFarmSubscriptions.js",
    "test": "tsc && node --test lib/features/account/plan.test.js lib/features/farmDefaults/defaults.test.js lib/features/ai/access.test.js lib/scripts/importPublicEvents.test.js lib/features/admin/admin.test.js lib/features/attachments/cleanup.test.js lib/features/market/arrivalDate.test.js lib/features/market/bestMandi.test.js",
    "migrate:subscriptions": "tsc && node lib/scripts/migrateSubscriptionsToOwners.js",
    "grant:tier": "tsc && node lib/scripts/grantTier.js",
    "admin:set": "tsc && node lib/scripts/setAdmin.js"
  },
  "dependencies": {
    "@google/genai": "2.24.0",
    "firebase-admin": "^14.4.0",
    "firebase-functions": "^7.4.0",
    "geotiff": "2.1.3",
    "google-auth-library": "10.9.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "eslint": "^10.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
